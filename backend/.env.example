APP_NAME=BankApp
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Casablanca
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ───── Database ─────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bankapp
DB_USERNAME=root
DB_PASSWORD=

# ───── Session / Cache / Queue ─────
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# ───── Sanctum (SPA stateless via Bearer) ─────
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173
SESSION_DOMAIN=localhost
FRONTEND_URL=http://localhost:5173

# ───── Mail (log en dev — pas de Mailhog) ─────
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@bankapp.test"
MAIL_FROM_NAME="${APP_NAME}"

# ───── SMS (Twilio) ─────
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=+212600000000

# ───── BankApp business config ─────
BANK_DEFAULT_CURRENCY=MAD
BANK_TRANSFER_OTP_THRESHOLD=1000       # montant en MAD au-delà duquel l'OTP est requis pour virement
BANK_DAILY_TRANSFER_LIMIT=50000
BANK_OTP_EXPIRY_MINUTES=5
BANK_MAX_OTP_ATTEMPTS=5
